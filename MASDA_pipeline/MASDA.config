conda.enabled = true
// Here change the path with the corresponding path to your version of the environment.
params.env_path = "/media/Disco12/slicandro/miniconda3/envs/pipeline_env"

process {
    withName: trim_adapters {
    conda = params.env_path
    }
    withName: filter_quality {
    conda = params.env_path
    }
    withName: kraken2_filter {
    conda = params.env_path
    }
    withName: bowtie_mapping {
    conda = params.env_path
    }
    withName: samtools {
    conda = params.env_path
    }
    withName: feature_counts {
    conda = params.env_path
    }
    withName: bowtie_map2paneltargets {
    conda = params.env_path
    }
    withName: count_targets {
    conda = params.env_path
    }
    withName: seqtk_fastq_filter {
    conda = params.env_path
    }
    executor = 'local'
    cpus = 1
    memory = '30 GB'
    time = '6h'
    withLabel: 'long' {
        cpus = 1
        time = '24h'
        memory = '30 GB'
    }
}

executor {
    cpus = 30
    memory = '100 GB'
}

executor.cpus = 30
executor.memory = '100 GB'

singularity {
    enabled = true
    autoMounts = true
}

profiles {
    standard {
        process.executor = 'local'
    }

    // The 'cluster' profile is intended for running the pipeline on SLURM clusters.
    cluster {
        process.executor = 'slurm'
    }
}